  <!--============== Part: P2, Measure: 126 ==============-->
  <measure number="126" width="297">
   <direction>
    <direction-type>
     <words default-x="297" default-y="-198" justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">Grandad Piet</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">Painful memories surge the sea</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">of emotions</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">I am a ship that has lost its</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">bearings for a while</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">I see him</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">like the very last time</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">- when the old man cried</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">for losing his son</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">How often I have cried for losing you -</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">blind and broken</words>
     <words justify="left" valign="middle" font-family="Arial" font-style="normal" font-size="7.56" font-weight="normal">friendly old man</words>
    </direction-type>
